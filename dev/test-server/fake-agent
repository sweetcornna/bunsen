#!/bin/bash
# 假的代理程序：模拟一个交互式的命令行代理，用来测部署、输入、重启和断线复用。
#   fake-agent [--continue] [--yolo] [--plugin-dir DIR] [初始提示]
echo "fake-agent 1.0 已启动 pid=$$ cwd=$(pwd)"
for a in "$@"; do echo "参数: $a"; done
if [ "${1:-}" = "--version" ]; then exit 0; fi
n=0
while IFS= read -r -p "fake> " line; do
  n=$((n + 1))
  case "$line" in
    /exit) echo "再见"; exit 0 ;;
    /fail) echo "出错退出"; exit 3 ;;
    *) echo "[$n] 收到: $line" ;;
  esac
done
